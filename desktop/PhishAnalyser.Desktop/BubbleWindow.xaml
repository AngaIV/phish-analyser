<Window x:Class="PhishAnalyser.Desktop.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phish Analyser"
        Width="46" Height="46"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

  <!-- 46px ring gauge, per ui-design/bubble-states/mockup.html -->
  <Grid x:Name="Root" Width="46" Height="46" Background="Transparent"
        MouseLeftButtonDown="OnBubbleMouseDown"
        MouseMove="OnBubbleMouseMove"
        MouseLeftButtonUp="OnBubbleMouseUp"
        Cursor="Hand">

    <!-- Right-click menu: WindowStyle="None" removes every other way to close the app. -->
    <Grid.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Open detail panel" IsEnabled="False" />
        <Separator />
        <MenuItem Header="Exit" Click="OnExitClick" />
      </ContextMenu>
    </Grid.ContextMenu>

    <Ellipse Fill="#FFFFFF" />

    <!-- Track -->
    <Ellipse Width="40" Height="40" Stroke="#EDF1F6" StrokeThickness="3.5" />

    <!-- Progress arc. Geometry already starts at 12 o'clock, so the rotation is used
         only as the pivot for the "analysing" sweep animation. -->
    <Path x:Name="Arc"
          StrokeThickness="3.5"
          StrokeStartLineCap="Round"
          StrokeEndLineCap="Round"
          RenderTransformOrigin="0.5,0.5">
      <Path.RenderTransform>
        <RotateTransform x:Name="ArcRotation" Angle="0" />
      </Path.RenderTransform>
    </Path>

    <TextBlock x:Name="Glyph"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontFamily="Segoe UI"
               FontSize="15"
               FontWeight="SemiBold"
               Text="0" />
  </Grid>
</Window>